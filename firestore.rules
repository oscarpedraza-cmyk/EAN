rules_version = '2';

// El cliente escribe directo a Firestore, así que estas reglas son el único control.
// Quedan cerradas a propósito: ábrelas solo cuando la app tenga autenticación.
service cloud.firestore {
  match /databases/{database}/documents {
    match /mentorias_ci/{encuentroId} {
      allow read, write: if false;
    }
  }
}
