# ─── Gemini ───────────────────────────────────────────────────────────────────
# Opción A · Gemini Developer API (la más rápida de poner en marcha)
GEMINI_API_KEY=

# Opción B · Vertex AI (mismo SDK, credenciales de Google Cloud)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=mi-proyecto
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/ruta/a/service-account.json

# Modelo a usar. Por defecto gemini-1.5-flash.
# GEMINI_MODEL=gemini-1.5-flash

# ─── Firebase / Firestore (opcional) ──────────────────────────────────────────
# Sin estas variables la app guarda las sesiones en el navegador (localStorage).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIRESTORE_COLLECTION=mentorship_sessions
